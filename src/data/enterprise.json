    {
      "id": "proc.pattern-a",
      "kind": "process",
      "name": "Pattern A · витрина из EVA",
      "domainId": "dom.data",
      "category": "delivery",
      "owner": "emp.product-owner",
      "description": "Федеративный источник: данные читаются у источника через Trino, без склада Landing. По ленте Nessie: Bronze → Silver → Gold, затем Cube.dev отгружает витрину, ИСТОК проверяет контракт, отчётность получает.",
      "steps": [
        {
          "id": "source",
          "name": "Источник подключён Trino-каталогом",
          "actorId": "sys.eva",
          "duration": 1.5
        },
        {
          "id": "bronze",
          "name": "stg_eva__transitions: dedup, type cast",
          "actorId": "layer.bronze",
          "transport": "pipe",
          "via": [
            "sys.dagster",
            "sys.trino",
            "sys.nessie"
          ],
          "carries": "dp.stg-eva-transitions",
          "flow": "data",
          "duration": 3
        },
        {
          "id": "silver",
          "name": "corpgov_dim__transition: ключи, SCD2",
          "actorId": "layer.silver",
          "via": [
            "sys.dagster",
            "sys.trino",
            "sys.nessie"
          ],
          "carries": "dp.corpgov-dim-transition",
          "flow": "data",
          "duration": 3.5
        },
        {
          "id": "gold",
          "name": "corpgov_exp__transitions → merge в main (CI)",
          "actorId": "layer.gold",
          "via": [
            "sys.dagster",
            "sys.trino",
            "sys.nessie",
            "sys.gitlab"
          ],
          "carries": "dp.corpgov-exp-transitions",
          "flow": "nessie",
          "duration": 3
        },
        {
          "id": "load",
          "name": "Cube.dev: погрузка в грузовик",
          "actorId": "sys.cube",
          "carries": "dp.corpgov-exp-transitions",
          "duration": 2.5
        },
        {
          "id": "contract",
          "name": "Проверка контракта и прав",
          "actorId": "sys.istok",
          "carries": "dp.corpgov-exp-transitions",
          "duration": 2
        },
        {
          "id": "deliver",
          "name": "Доставка в отчётность",
          "actorId": "sys.bi",
          "duration": 2
        }
      ]
    },
    {
      "id": "proc.pattern-b",
      "kind": "process",
      "name": "Pattern B · загрузка через dlt",
      "domainId": "dom.data",
      "category": "ingestion",
      "owner": "emp.data-engineer",
      "description": "Источник без SQL-интерфейса: dlt привозит данные на склад Landing, дальше по ленте Nessie — Bronze и Silver.",
      "steps": [
        {
          "id": "api",
          "name": "Выдача данных по API",
          "actorId": "sys.extapi",
          "duration": 1.5
        },
        {
          "id": "dlt",
          "name": "dlt-пайплайн по расписанию",
          "actorId": "sys.dlt",
          "via": [
            "sys.dagster",
            "sys.infisical"
          ],
          "flow": "data",
          "duration": 3
        },
        {
          "id": "landing",
          "name": "Разгрузка на склад Landing as-is",
          "actorId": "layer.landing",
          "carries": "dp.landing-extapi-requests",
          "flow": "data",
          "duration": 2
        },
        {
          "id": "bronze",
          "name": "stg_extapi__requests",
          "actorId": "layer.bronze",
          "via": [
            "sys.dagster",
            "sys.trino",
            "sys.nessie"
          ],
          "carries": "dp.stg-extapi-requests",
          "flow": "data",
          "duration": 3
        },
        {
          "id": "silver",
          "name": "corpgov_fct__request",
          "actorId": "layer.silver",
          "via": [
            "sys.dagster",
            "sys.trino",
            "sys.nessie"
          ],
          "carries": "dp.corpgov-fct-request",
          "flow": "data",
          "duration": 3
        }
      ]
    },
    {
      "id": "proc.change",
      "kind": "process",
      "name": "Изменение модели: Git → Nessie → релиз",
      "domainId": "dom.data",
      "category": "change",
      "owner": "emp.product-owner",
      "description": "Изменение почти всегда проходит все три флоу. Пропуск одного — типичная причина «в Git готово, а в проде нет».",
      "steps": [
        {
          "id": "local",
          "name": "Правка в личной ветке, локальные слои",
          "actorId": "emp.data-engineer",
          "flow": "git",
          "duration": 2
        },
        {
          "id": "mr",
          "name": "MR в dp-transform",
          "actorId": "sys.gitlab",
          "flow": "git",
          "duration": 1.5
        },
        {
          "id": "review",
          "name": "Ревью MR",
          "actorId": "emp.product-owner",
          "manual": true,
          "flow": "git",
          "duration": 5
        },
        {
          "id": "ci",
          "name": "CI: тесты, проверка имён, образ",
          "actorId": "sys.gitlab",
          "flow": "git",
          "duration": 2
        },
        {
          "id": "rebuild",
          "name": "Пересборка в своей ref на ленте → merge в main",
          "actorId": "sys.nessie",
          "via": [
            "sys.dagster",
            "sys.trino"
          ],
          "flow": "nessie",
          "duration": 3
        },
        {
          "id": "release",
          "name": "Тег образа и release manifest",
          "actorId": "sys.gitlab",
          "flow": "release",
          "duration": 1.5
        },
        {
          "id": "deploy",
          "name": "Выкладка образа в Dagster",
          "actorId": "sys.dagster",
          "flow": "release",
          "duration": 2
        },
        {
          "id": "notify",
          "name": "Сообщение потребителям в dp-changelog",
          "actorId": "emp.product-owner",
          "manual": true,
          "flow": "release",
          "duration": 4,
          "automation": "Публиковать changelog автоматически из release manifest и изменений контрактов; владелец дополняет при необходимости."
        }
      ]
    },
    {
